# Seules 3 variables sont nécessaires. Les clés Kie / stockage se saisissent dans Admin > Settings.
DATABASE_URL=postgres://user:pass@ep-xxx.neon.tech/neondb?sslmode=require
AUTH_SECRET=       # openssl rand -base64 32
ENCRYPTION_KEY=    # openssl rand -base64 32 (chiffre les clés stockées en base — à ne jamais changer)
CRON_SECRET=       # obligatoire pour le cron Vercel (openssl rand -base64 32)
# Optionnel : GENERATION_DAILY_LIMIT=1000  GENERATION_INFLIGHT_LIMIT=20
